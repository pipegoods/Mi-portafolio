---

<section id="experiencia" class="relative scroll-mt-8 py-14">
  <span class="node top-[4.1rem] -left-8 -translate-x-1/2" data-node></span>

  <p class="eyebrow reveal">Experiencia</p>

  <ul class="mt-10 flex flex-col gap-16">
    {
      experiences.map((exp) => (
        <li class="reveal">
          <header class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="display text-xl md:text-2xl">{exp.companyName}</h3>
            <p class="font-mono text-xs text-graphite">{exp.location}</p>
          </header>

          <ul class="mt-6 flex flex-col">
            {exp.roles.map((role) => (
              <li class="border-t border-hairline py-6">
                <header class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h4 class="font-semibold">{role.roleName}</h4>
                  <p class="font-mono text-xs text-graphite">
                    {role.startDate} — {role.endDate}
                  </p>
                </header>

                <ul class="mt-4 flex flex-col gap-2.5">
                  {role.tasks.map((task) => (
                    <li class="relative pl-5 text-graphite">
                      <span
                        class="absolute top-2.5 left-0 h-px w-3 bg-tiffany"
                        aria-hidden="true"
                      />
                      {task}
                    </li>
                  ))}
                </ul>

                <p class="mt-4 font-mono text-xs text-graphite">
                  {role.stack.join("  ·  ")}
                </p>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</section>
