---
import type { CvData } from "../data/types.ts";
import ChevronUp from "./icons/ChevronUp.astro";

interface Props {
  data: CvData;
}

const { data } = Astro.props;
const year = new Date().getFullYear();
---

<footer
  class="relative flex flex-wrap items-center justify-between gap-4 border-t border-hairline py-10"
>
  <span class="node top-[-5px] -left-8 -translate-x-1/2" data-node></span>

  <p class="font-mono text-xs text-graphite">
    © {year} {data.profile.name} · {data.profile.location}
  </p>

  <a
    href="#trabajo"
    class="inline-flex items-center gap-2 font-mono text-xs text-graphite transition-colors hover:text-signal"
  >
    <ChevronUp />
    {data.ui.backToTop}
  </a>
</footer>
