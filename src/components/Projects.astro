---
import type { CvData } from "../data/types.ts";

interface Props {
  data: CvData;
}

const { data } = Astro.props;
const projects = data.projects;
---

<section id="proyectos" class="relative scroll-mt-8 py-14">
  <span class="node top-[4.1rem] -left-8 -translate-x-1/2" data-node></span>

  <p class="eyebrow reveal">{data.ui.sections.projects}</p>

  <ul class="mt-10 grid gap-px border border-hairline bg-hairline sm:grid-cols-2">
    {
      projects.map((project) => (
        <li class="reveal group relative flex flex-col gap-5 bg-paper p-6 transition-colors hover:bg-white">
          {project.link && (
            <a
              href={project.link}
              target="_blank"
              rel="noopener"
              aria-label={`${project.linkLabel ?? data.ui.viewOnGithub}: ${project.name}`}
              class="absolute inset-0 z-10"
            />
          )}

          <div class="flex flex-1 flex-col gap-3">
            <h3 class="display text-lg group-hover:text-signal">
              {project.name}
            </h3>
            <p class="text-sm text-graphite">{project.description}</p>
          </div>

          <ul class="flex flex-wrap gap-x-3 gap-y-1">
            {project.technologies.map((tech) => (
              <li class="font-mono text-[0.6875rem] tracking-wide text-graphite">
                {tech}
              </li>
            ))}
          </ul>

          {project.link && (
            <p class="font-mono text-xs text-signal">
              {project.linkLabel ?? data.ui.viewOnGithub} →
            </p>
          )}
        </li>
      ))
    }
  </ul>
</section>
