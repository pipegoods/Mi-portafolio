---
import type { CvData } from "../data/types.ts";

interface Props {
  data: CvData;
}

const { data } = Astro.props;
const { about, stack } = data.profile;
---

<section id="trabajo" class="relative scroll-mt-8 py-14 lg:pt-24">
  <span class="node top-18 -left-8 -translate-x-1/2" data-node></span>

  <h2 class="eyebrow reveal">{data.ui.sections.about}</h2>

  <div class="reveal mt-6 flex max-w-xl flex-col gap-4 text-lg text-graphite">
    {about.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  <p class="reveal mt-8 font-mono text-sm text-graphite">
    {stack.join(" · ")}
  </p>
</section>
